    {"method": "GET", "path": "/api/health", "desc": "Status server"},
    {"method": "GET", "path": "/api/stats", "desc": "Statistik katalog, tipe, status, genre"},
    {"method": "GET", "path": "/api/series", "desc": "Daftar series. Filter: q, type, status, genre, demographic, theme, min_chapters, max_chapters, sort, page, per_page"},
    {"method": "GET", "path": "/api/series/{id|slug}", "desc": "Detail lengkap + seluruh daftar chapter. ?live=1 paksa ambil upstream"},
    {"method": "GET", "path": "/api/series/{id|slug}/chapters", "desc": "Daftar chapter (paginasi)"},
