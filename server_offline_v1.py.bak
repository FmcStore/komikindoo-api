    {"method": "GET", "path": "/api/chapters/{chapterId}", "desc": "Isi chapter: daftar URL gambar + prev/next"},
    {"method": "GET", "path": "/api/chapters/{chapterId}/images", "desc": "Hanya array URL gambar + host"},
    {"method": "GET", "path": "/api/search", "desc": "Cari judul lokal, fallback ke upstream kalau kosong"},
    {"method": "GET", "path": "/api/latest", "desc": "Rilis terbaru (live upstream, urutan asli)"},
    {"method": "GET", "path": "/api/popular", "desc": "Terpopuler (live upstream)"},
    {"method": "GET", "path": "/api/recommendations", "desc": "Rekomendasi (live upstream)"},
    {"method": "GET", "path": "/api/colorized", "desc": "Judul berwarna/colorized (live upstream)"},
    {"method": "GET", "path": "/api/genres", "desc": "Semua genre, demographic, theme + jumlah judul"},
    {"method": "GET", "path": "/api/types", "desc": "Jumlah judul per tipe"},
    {"method": "GET", "path": "/api/random", "desc": "Satu series acak yang sudah ada detailnya"},
    {"method": "GET", "path": "/api/refresh", "desc": "Picu rescrape background. ?scope=catalog|details|images|all"},
]

ROUTES = [
    ("GET", r"^/api$", h_api),
    ("GET", r"^/api/$", h_api),
    ("GET", r"^/api/health$", h_health),
    ("GET", r"^/api/stats$", h_stats),
    ("GET", r"^/api/series$", h_series),
    ("GET", r"^/api/series/([^/]+)$", h_series_detail),
    ("GET", r"^/api/series/([^/]+)/chapters$", h_series_chapters),
    ("GET", r"^/api/series/([^/]+)/chapters/([^/]+)$", h_series_chapter_by_number),
    ("GET", r"^/api/chapters/(\d+)$", h_chapter),
    ("GET", r"^/api/chapters/(\d+)/images$", h_chapter_images),
    ("GET", r"^/api/search$", h_search),
    ("GET", r"^/api/latest$", h_latest),
    ("GET", r"^/api/popular$", h_popular),
    ("GET", r"^/api/recommendations$", h_recommendations),
    ("GET", r"^/api/colorized$", h_colorized),
    ("GET", r"^/api/genres$", h_genres),
    ("GET", r"^/api/types$", h_types),
    ("GET", r"^/api/random$", h_random),
    ("GET", r"^/api/refresh$", h_refresh),
]

VARNAMES = {
    r"^/api/series/([^/]+)$": ["key"],
    r"^/api/series/([^/]+)/chapters$": ["key"],
    r"^/api/series/([^/]+)/chapters/([^/]+)$": ["key", "num"],
    r"^/api/chapters/(\d+)$": ["cid"],
    r"^/api/chapters/(\d+)/images$": ["cid"],
}

REFRESH = {"running": False, "since": None, "done": None, "scope": None}
STARTED = time.time()


class Handler(BaseHTTPRequestHandler):
    server_version = "komikindo-api/" + VERSION
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *a):
        if self.path not in ("/api/health",):
            print("[%s] %s" % (time.strftime("%H:%M:%S"), fmt % a), flush=True)

    def _send(self, code, payload, extra_headers=None):
        body = json.dumps(payload, ensure_ascii=False, indent=2).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, OPTIONS")
        self.send_header("Cache-Control", "no-store")
        for k, v in (extra_headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "*")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self):
        t0 = now_ms()
        parsed = urllib.parse.urlsplit(self.path)
        path = parsed.path.rstrip("/") or "/"
        if not path.startswith("/api"):
            path = "/api"  # root = katalog endpoint (JSON murni, tanpa UI)
        query = urllib.parse.parse_qs(parsed.query, keep_blank_values=False)
        env = {"params": query, "query": {k: v[0] for k, v in query.items()},
               "vars": {}, "source": []}
        import re as _re
        handler = None
        for method, pattern, fn in ROUTES:
            m = _re.match(pattern, path)
            if m:
                handler = fn
                names = VARNAMES.get(pattern)
                if names:
                    for n, v in zip(names, m.groups()):
                        env["vars"][n] = v
                break
        if handler is None:
            self._send(404, {"ok": False, "error": {
                "code": 404, "message": "route %r tidak ada. lihat GET /api" % path}})
            return
        conn = None
        try:
            conn = db()
            env["conn"] = conn
            data = handler(env)
            self._send(200, {"ok": True, "cached": False,
                             "elapsedMs": now_ms() - t0,
                             "source": env["source"] or None, "data": data})
        except ApiError as e:
            self._send(e.code, {"ok": False, "elapsedMs": now_ms() - t0,
                                "error": {"code": e.code, "message": e.message}})
        except Exception as e:
            self._send(500, {"ok": False, "elapsedMs": now_ms() - t0,
                             "error": {"code": 500, "message": "%s: %s" % (type(e).__name__, e)}})
        finally:
            if conn is not None:
                conn.close()


def main():
    global DB_PATH
    ap = argparse.ArgumentParser(description="KomikIndo REST API")
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--port", type=int, default=8797)
    ap.add_argument("--db", default=DB_PATH)
    a = ap.parse_args()
    DB_PATH = a.db
    store.init(DB_PATH)
    if not os.path.exists(DB_PATH):
        print("DB belum ada, jalankan: python3 scraper.py catalog")
    srv = ThreadingHTTPServer((a.host, a.port), Handler)
    srv.daemon_threads = True
    print("KomikIndo REST API %s di http://%s:%d  (db=%s)" % (VERSION, a.host, a.port, DB_PATH))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
